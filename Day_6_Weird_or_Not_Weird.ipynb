      "source": [
        "# Day 6 - Operators and Conditional Statements\n",
        "\n",
        "n = int(input(\"Enter a positive integer: \"))\n",
        "\n",
        "if n % 2 != 0:\n",
        "    print(\"Weird\")\n",
        "elif 2 <= n <= 5:\n",
        "    print(\"Not Weird\")\n",
        "elif 6 <= n <= 20:\n",
        "    print(\"Weird\")\n",
        "elif n > 20:\n",
        "    print(\"Not Weird\")\n"
      ],
      "id": "vq13giYpzM4s"
    }
